            <xhtml:p><![CDATA[(*Sintaxis y Ejemplo - Sentencia IF*)
IF iNivelTanque < 30 THEN
    xBomba := TRUE;
  ELSE
    xBomba := FALSE;
END_IF;

(*Sintaxis y Ejemplo - Sentencia FOR*)
ArraySensores[0] := iSensor_1;
ArraySensores[1] := iSensor_2;
ArraySensores[2] := iSensor_3;
ArraySensores[3] := iSensor_4;

FOR i := 0 TO 3 BY 1 DO
  IF ArraySensores[i] > 80 THEN
    xAlarmaSobretemperatura := TRUE;
  END_IF;
END_FOR;

(*Sintaxis y Ejemplo - Sentencia CASE*)
CASE iTipoProducto OF
  1: rVelocidadCinta := 0.5; (*Producto liviano*)
  2: rVelocidadCinta := 1.0; (*Producto estándar*)
  3: rVelocidadCinta := 1.5; (*Producto pesado*)
  ELSE
    rVelocidadCinta := 0.0;
END_CASE;



]]></xhtml:p>
